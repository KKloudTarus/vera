# syntax=docker/dockerfile:1

FROM python:3.11-slim-bookworm@sha256:0bee7276f83efd4a1ee05bbbf4281d95ed28e079220a9457f25a93e3f1e3c31b

ARG VERA_BUILD_GIT_SHA=unknown
ARG VERA_BUILD_GIT_DIRTY=true

LABEL org.opencontainers.image.revision="${VERA_BUILD_GIT_SHA}"

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=30 \
    PIP_RETRIES=5 \
    PIP_CONSTRAINT=/workspace/constraints.lock \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace

WORKDIR /workspace

COPY pyproject.toml constraints.lock README.md LICENSE NOTICE ./
COPY src ./src

RUN --mount=type=cache,id=vera-pip,target=/root/.cache/pip \
    python -m pip install pip==26.2 setuptools==84.0.0 wheel==0.48.0 \
    && python -m pip install --constraint constraints.lock -e ".[all]"

COPY evals ./evals
COPY deploy ./deploy
COPY docs ./docs

RUN printf '{"git_sha":"%s","git_dirty":%s}\n' \
      "$VERA_BUILD_GIT_SHA" "$VERA_BUILD_GIT_DIRTY" > /workspace/build-metadata.json

RUN groupadd --system evaluator \
    && useradd --system --gid evaluator --home-dir /workspace evaluator \
    && mkdir -p /output /state \
    && chown evaluator:evaluator /output /state

USER evaluator

CMD ["python", "-m", "evals.validate"]
