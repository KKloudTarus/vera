{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vera.local/evals/schemas/case.schema.json",
  "title": "VERA evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "suite",
    "priority",
    "profiles",
    "mode",
    "objective",
    "capability_expectation",
    "isolation",
    "cleanup_strategy",
    "tags",
    "fixture",
    "steps",
    "assertions",
    "metrics",
    "likely_first_bad_boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "type": "string",
      "enum": [
        "end_to_end",
        "ingestion",
        "curation",
        "temporal",
        "retrieval",
        "security",
        "answer",
        "performance",
        "resilience",
        "learning",
        "outcome"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2"]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["daily", "nightly", "weekly", "release"]
      }
    },
    "mode": {
      "type": "string",
      "enum": ["static", "unit", "integration", "e2e", "load", "manual", "qualitative"]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "capability_expectation": {
      "type": "string",
      "enum": ["supported", "gap_probe"]
    },
    "isolation": {
      "type": "string",
      "enum": ["none", "dedicated_synthetic_scope", "ephemeral_stack"]
    },
    "cleanup_strategy": {
      "type": "string",
      "enum": ["none_read_only", "run_scope_cleanup", "ephemeral_stack_destroy"]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixture": {
      "type": "object"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "likely_first_bad_boundary": {
      "$ref": "#/$defs/boundary"
    },
    "cleanup": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "task_ref",
        "documents_ref",
        "candidate_output_ref",
        "rubric_path",
        "panel_policy_path",
        "answer_key_policy"
      ],
      "properties": {
        "method": {
          "type": "string",
          "const": "external_panel"
        },
        "task_ref": {"type": "string", "minLength": 1},
        "documents_ref": {"type": "string", "minLength": 1},
        "candidate_output_ref": {"type": "string", "minLength": 1},
        "rubric_path": {"type": "string", "minLength": 1},
        "panel_policy_path": {"type": "string", "minLength": 1},
        "answer_key_policy": {
          "type": "string",
          "const": "rubric_only_no_canonical_answer"
        }
      }
    },
    "boundary": {
      "type": "string",
      "enum": [
        "L0_OUTCOME",
        "L1_ANSWER",
        "L2_RETRIEVAL",
        "L3_PROJECTION",
        "L4_TEMPORAL",
        "L5_CURATION",
        "L6_INGESTION",
        "L7_RUNTIME",
        "CROSS_CUTTING"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "input", "observe"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "Must match an action name in evals/action_catalog.json."
        },
        "input": {
          "type": "object"
        },
        "observe": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "gate", "activation", "target", "operator", "expected", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A[0-9]+$"
        },
        "severity": {
          "type": "string",
          "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]
        },
        "gate": {
          "type": "boolean"
        },
        "activation": {
          "type": "string",
          "enum": ["always", "baseline_required", "agent_runner_required", "capability_probe"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "contains",
            "not_contains",
            "exists",
            "absent",
            "gte",
            "lte",
            "lt",
            "gt",
            "all",
            "none",
            "unchanged",
            "equivalent"
          ]
        },
        "expected": {},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimum_sample_size": {
          "type": "integer",
          "minimum": 1
        },
        "threshold_source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
