{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vera.local/evals/judging/schemas/judge-packet.schema.json",
  "title": "VERA external judge packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "run", "scenario", "task", "source_material", "candidate", "system_evidence", "hard_constraints", "reference_catalog", "rubric", "panel_policy", "judge_contract"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "packet_id": {"type": "string", "minLength": 1},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "case_id", "profile", "dataset_sha256", "service_version", "git_sha", "generated_at"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"},
        "profile": {"type": "string", "enum": ["daily", "nightly", "weekly", "release"]},
        "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "service_version": {"type": "string", "minLength": 1},
        "git_sha": {"type": "string", "minLength": 7},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "objective", "persona", "tags", "answer_key_policy"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "persona": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "answer_key_policy": {"type": "string", "const": "rubric_only_no_canonical_answer"}
      }
    },
    "task": {"type": "object"},
    "source_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_only", "documents", "document_count", "sha256"],
      "properties": {
        "synthetic_only": {"type": "boolean", "const": true},
        "documents": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "document_count": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "identity_blinded", "output"],
      "properties": {
        "alias": {"type": "string", "const": "candidate-A"},
        "identity_blinded": {"type": "boolean", "const": true},
        "output": {}
      }
    },
    "system_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_observations", "tool_trace", "citations", "result_ids"],
      "properties": {
        "boundary_observations": {"type": "object"},
        "tool_trace": {"type": "array"},
        "citations": {"type": "array"},
        "result_ids": {"type": "array"}
      }
    },
    "hard_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "assertions"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "assertions": {"type": "array", "items": {"type": "object"}}
      }
    },
    "reference_catalog": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "pointer"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["task", "document", "candidate", "tool_call", "citation", "result", "hard_assertion"]},
          "pointer": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "rubric": {"type": "object"},
    "panel_policy": {"type": "object"},
    "judge_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "judgment_schema", "packet_sha256_excluded"],
      "properties": {
        "instructions": {"type": "string", "minLength": 1},
        "judgment_schema": {"type": "string", "minLength": 1},
        "packet_sha256_excluded": {"type": "boolean", "const": true}
      }
    }
  }
}
