# Copy to .env for local development. Never commit real secrets.
# All variables are prefixed VERA_ and nested with __ (see vera/config/settings.py).

# --- shared ---
VERA_ENVIRONMENT=local
VERA_LOG_LEVEL=INFO
VERA_LOG_JSON=false            # false = pretty console logs in dev; true = JSON in prod
VERA_SERVICE_NAME=vera

# --- api ---
VERA_API__HOST=0.0.0.0
VERA_API__PORT=8000
VERA_API__CORS_ORIGINS=["http://localhost:3000"]

# --- database (source of truth) ---
# VERA_POSTGRES_HOST_PORT is the host port docker-compose maps to postgres:5432.
# Override it if 5432 is already taken on your machine, and match it in the DSN.
VERA_POSTGRES_HOST_PORT=5432
VERA_DB__DSN=postgresql+asyncpg://vera:vera@localhost:5432/vera
VERA_DB__POOL_SIZE=5
VERA_DB__MAX_OVERFLOW=10
VERA_DB__POOL_PRE_PING=true

# --- object store (S3-compatible: MinIO/Ceph/…) ---
VERA_OBJECTSTORE__ENDPOINT_URL=http://localhost:9000
VERA_OBJECTSTORE__BUCKET=vera-artifacts
VERA_OBJECTSTORE__ACCESS_KEY=minioadmin
VERA_OBJECTSTORE__SECRET_KEY=minioadmin

# --- worker ---
VERA_WORKER__LANES=8
VERA_WORKER__POLL_INTERVAL_MS=500
VERA_WORKER__BATCH_SIZE=20
VERA_WORKER__VISIBILITY_TIMEOUT_S=300

# --- mcp ---
VERA_MCP__HOST=0.0.0.0
VERA_MCP__PORT=8080
# JSON allowlists for DNS-rebinding protection. Add the deployed MCP hostname and any
# browser client origins in production; requests without an allowed Host are rejected.
VERA_MCP__ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","[::1]:*"]
VERA_MCP__ALLOWED_ORIGINS=[]
# MCP metrics use a separate scrape-only listener; Compose does not publish this port.
VERA_OBSERVABILITY__MCP_METRICS_HOST=127.0.0.1
VERA_OBSERVABILITY__MCP_METRICS_PORT=9101
# coding (default): core canonical tools; advanced: all knowledge_* tools;
# compatibility: all canonical tools plus legacy memory_* aliases.
VERA_MCP__TOOL_PROFILE=coding
# With no JWT secret in local mode, MCP provisions one stable local principal automatically.
# Override its UUID only when you need to attach explicit workspace memberships.
# VERA_MCP__LOCAL_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000

# --- memory engine (graphiti) ---
# provider: 'null' (default, no graph needed) or 'graphiti'.
# embedder: 'deterministic' (offline, no key), 'openai' (VERA_MEMORY__OPENAI_API_KEY), or
#           'voyage' (Voyage AI; set VERA_VOYAGE__API_KEY and match EMBEDDING_DIM below).
# Text ingestion needs an LLM key; triple ingestion and RRF search work offline.
VERA_MEMORY__PROVIDER=null
VERA_MEMORY__EMBEDDER=deterministic
VERA_MEMORY__EMBEDDING_DIM=1024
# VERA_MEMORY__VECTOR_SEARCH_ENABLED=true
# VERA_MEMORY__OPENAI_API_KEY=sk-...
# OpenAI-compatible local endpoint. From Docker Desktop use host.docker.internal, not localhost.
# Use VERA_MEMORY__OPENAI_API_KEY=local if the endpoint requires no authentication; Vera uses
# key presence to enable free-text extraction and other LLM-backed features.
# VERA_MEMORY__OPENAI_BASE_URL=http://host.docker.internal:20128/v1
# VERA_MEMORY__LLM_MODEL=codex/gpt-5.6-sol
# VERA_MEMORY__SMALL_LLM_MODEL=codex/gpt-5.6-terra

# --- Voyage AI (optional: embeddings and/or reranking) ---
# Paste your key below. Then, to use Voyage for embeddings, set
#   VERA_MEMORY__EMBEDDER=voyage  and  VERA_VOYAGE__EMBEDDING_DIM=1024 (match the model).
# To use the Voyage reranker (stage-3), set:
#   VERA_RERANK__CROSS_ENCODER_ENABLED=true  and  VERA_RERANK__CROSS_ENCODER_PROVIDER=voyage
# Models are free to change (voyage-3.5 / voyage-4-lite / voyage-code-4; rerank-2.5 / -lite).
VERA_VOYAGE__API_KEY=
VERA_VOYAGE__EMBEDDING_MODEL=voyage-3.5
VERA_VOYAGE__EMBEDDING_DIM=1024
VERA_VOYAGE__RERANK_MODEL=rerank-2.5
# VERA_RERANK__CROSS_ENCODER_ENABLED=true
# VERA_RERANK__CROSS_ENCODER_PROVIDER=voyage
# VERA_RERANK__CROSS_ENCODER_MIN_SCORE=0.35
VERA_NEO4J__URI=bolt://localhost:7687
VERA_NEO4J__USER=neo4j
VERA_NEO4J__PASSWORD=change-me
